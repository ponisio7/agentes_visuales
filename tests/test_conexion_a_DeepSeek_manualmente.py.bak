class TestDeepSeekConfiguracion:
    """Pruebas de configuración y utilidades de DeepSeek."""
    
    def test_constantes_default_correctas(self):
        """
        CORREGIDO: Testea las constantes directamente sin reload del módulo.
        El reload causaba efectos secundarios impredecibles.
        """
        assert DEEPSEEK_BASE_URL_DEFAULT == 'https://api.deepseek.com'
        assert DEFAULT_MODEL_DEFAULT == 'deepseek-v4-flash'
    
    def test_get_deepseek_client_usa_url_por_defecto(self):
        """Verifica que get_deepseek_client usa la URL correcta por defecto."""
        try:
            import openai
        except ImportError:
            pytest.skip("openai no está instalado")
        
        client = get_deepseek_client(api_key='test-key')
        assert 'deepseek.com' in str(client.base_url)
    
    def test_get_deepseek_client_sobreescribe_url(self):
        """Verifica que se puede sobreescribir la URL base."""
        try:
            import openai
        except ImportError:
            pytest.skip("openai no está instalado")
        
        custom_url = 'https://mi-api.custom.com/v1'
        client = get_deepseek_client(api_key='test-key', base_url=custom_url)
        assert custom_url.rstrip('/') in str(client.base_url).rstrip('/')


# ============================================================
# PRUEBAS DE INTEGRACIÓN CON EL SISTEMA
# ============================================================

@pytest.mark.integration
class TestDeepSeekIntegracion:
    """Pruebas de integración de DeepSeek con el sistema de agentes."""
    
    def test_agente_llm_creacion(self):
        """Prueba la creación de un agente LLM."""
        from core.agent import Agente, TipoAgente
        
        agente = Agente(
            nombre="Analizador",
            tipo=TipoAgente.LLM,
            prompt_llm="Analiza: {contexto}",
            modelo_llm=DEFAULT_MODEL_DEFAULT,
            temperatura_llm=0.7,
            max_tokens_llm=100
        )
        
        assert agente.tipo == TipoAgente.LLM
        assert agente.modelo_llm == DEFAULT_MODEL_DEFAULT
        assert agente.temperatura_llm == 0.7
        assert agente.max_tokens_llm == 100
    
    def test_agente_llm_validacion(self):
        """Prueba la validación de un agente LLM."""
        from core.agent import Agente, TipoAgente
        
        # Agente válido
        agente = Agente(
            nombre="LLMTest",
            tipo=TipoAgente.LLM,
            prompt_llm="Analiza: {contexto}",
            modelo_llm=DEFAULT_MODEL_DEFAULT
        )
        ok, msg = agente.validar_configuracion()
        assert ok is True, f"Validación falló inesperadamente: {msg}"
        assert msg == ""
        
        # Agente sin prompt
        agente_sin_prompt = Agente(
            nombre="LLMTest2",
            tipo=TipoAgente.LLM,
            prompt_llm="",
            modelo_llm=DEFAULT_MODEL_DEFAULT
        )
        ok, msg = agente_sin_prompt.validar_configuracion()
        assert ok is False
        assert "prompt" in msg.lower()
        
        # Agente sin modelo
        agente_sin_modelo = Agente(
            nombre="LLMTest3",
            tipo=TipoAgente.LLM,
            prompt_llm="Analiza: {contexto}",
            modelo_llm=""
        )
        ok, msg = agente_sin_modelo.validar_configuracion()
        assert ok is False
        assert "modelo" in msg.lower()
    
    @patch('openai.OpenAI')
    def test_ejecucion_agente_llm_mock(self, mock_openai_class):
        """
        Prueba la ejecución de un agente LLM con mock.
        CORREGIDO: El patch correcto es 'openai.OpenAI' ya que openai
        se importa dentro de _ejecutar_llm.
        """
        from core.agent import Agente, TipoAgente
        from core.executors import AgentExecutor
        
        # Configurar mock response
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "Respuesta mockeada del LLM"
        mock_response.usage = MagicMock()
        mock_response.usage.prompt_tokens = 10
        mock_response.usage.completion_tokens = 20
        mock_response.usage.total_tokens = 30
        
        mock_client = MagicMock()
        mock_client.chat.completions.create.return_value = mock_response
        mock_openai_class.return_value = mock_client
        
        # Crear agente LLM
        agente = Agente(
            nombre="LLMTest",
            tipo=TipoAgente.LLM,
            prompt_llm="Responde: {contexto}",
            modelo_llm=DEFAULT_MODEL_DEFAULT,
            temperatura_llm=0.7,
            max_tokens_llm=50
        )
        
        # Ejecutar con contexto
        contexto = {"contexto": "Dime algo interesante sobre Python"}
        
        # CORRECCIÓN: Patchear la variable de entorno Y el import de openai
        with patch.dict(os.environ, {'DEEPSEEK_API_KEY': 'test-key-fake'}):
            exito, mensaje, resultado = AgentExecutor.ejecutar(agente, contexto)
        
        # Verificar
        assert exito is True, f"Ejecución falló: {mensaje}"
        assert resultado is not None
        assert 'respuesta' in resultado
        assert "Respuesta mockeada" in resultado['respuesta']
        assert resultado['modelo'] == DEFAULT_MODEL_DEFAULT
    
    def test_agente_llm_sin_api_key(self):
        """Prueba que un agente LLM falle sin API key."""
        from core.agent import Agente, TipoAgente
        from core.executors import AgentExecutor

        agente = Agente(
            nombre="LLMTest",
            tipo=TipoAgente.LLM,
            prompt_llm="Responde: {contexto}",
            modelo_llm=DEFAULT_MODEL_DEFAULT,
        )

        # ✅ Parchear TANTO la variable de entorno COMO la carga desde archivos
        with patch.dict(os.environ, {}, clear=True), \
            patch('core.llm.client.cargar_entorno_desde_archivos', return_value={}):
            exito, mensaje, resultado = AgentExecutor.ejecutar(agente, {})

        assert exito is False
        assert "DEEPSEEK_API_KEY" in mensaje or "API key" in mensaje.lower()
        
# ============================================================
# PRUEBA DE PERFORMANCE (OPCIONAL)
# ============================================================

@pytest.mark.slow
@pytest.mark.skipif(
    not DEEPSEEK_API_KEY,
    reason="DEEPSEEK_API_KEY no está configurada"
)
class TestDeepSeekPerformance:
    """Pruebas de performance de la API DeepSeek."""
    
    def test_tiempo_respuesta(self):
        """Prueba el tiempo de respuesta de la API."""
        try:
            import openai
        except ImportError:
            pytest.skip("openai no está instalado")
        
        try:
            client = get_deepseek_client(api_key=DEEPSEEK_API_KEY)
        except ValueError as e:
            pytest.skip(f"No se pudo crear cliente: {e}")
        
        import time
        
        start = time.time()
        
        try:
            response = client.chat.completions.create(
                model=DEFAULT_MODEL_DEFAULT,
                messages=[{"role": "user", "content": "Hola, ¿cómo estás?"}],
                max_tokens=20
            )
            elapsed = time.time() - start
            
            # 15 segundos es generoso para APIs LLM
            assert elapsed < 15.0, f"Respuesta demasiado lenta: {elapsed:.2f}s"
            print(f"⏱ Tiempo de respuesta: {elapsed:.2f}s")
            
        except Exception as e:
            pytest.skip(f"Error en prueba de performance: {type(e).__name__}: {e}")



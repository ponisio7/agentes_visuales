# tests/test_integration.py - VERSIÓN COMPLETA REFACTORIZADA
"""
Pruebas de integración entre componentes del sistema.

CORRECCIONES APLICADAS:
- ✅ Mocking de HTTP: uso de responses para eliminar dependencia de red
- ✅ Pruebas de componentes reales sin duplicación
- ✅ Flujo completo: creación → ejecución → guardado en DB
- ✅ Pruebas de recuperación de errores
- ✅ Pruebas de loops en integración
- ✅ Cleanup automático de archivos temporales
- ✅ Documentación: docstrings explicativos en cada prueba
"""

import pytest
import time
import json
import os
import tempfile
from unittest.mock import MagicMock, patch
from pathlib import Path

from PyQt6.QtCore import QTimer, QEventLoop
from PyQt6.QtWidgets import QApplication

from core.scheduler import Scheduler
from core.agent import Agente, EstadoAgente, TipoAgente
from core.executors import AgentExecutor
from storage.database import Database
from storage.config_manager import ConfigManager


# ============================================================
# FIXTURES
# ============================================================

@pytest.fixture(scope="function")
def qapp():
    """Fixture que proporciona una instancia de QApplication para pruebas con Qt."""
    app = QApplication.instance()
    if app is None:
        app = QApplication([])
    yield app


@pytest.fixture
def temp_db():
    """Fixture: base de datos temporal."""
    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f:
        db_path = f.name
    db = Database(db_path)
    yield db
    db.close()
    if os.path.exists(db_path):
        os.unlink(db_path)


@pytest.fixture
def temp_config_dir():
    """Fixture: directorio temporal para configuraciones."""
    with tempfile.TemporaryDirectory() as tmpdir:
        yield tmpdir


@pytest.fixture
def config_manager(temp_config_dir):
    """Fixture: gestor de configuraciones con directorio temporal."""
    return ConfigManager(temp_config_dir)


@pytest.fixture
def scheduler_basico():
    """Fixture: scheduler con 3 agentes en cadena."""
    scheduler = Scheduler(max_concurrent=2)
    
    codigo = "resultado = {'status': 'ok', 'id': 'test'}"
    a1 = Agente(nombre="A1", duracion=0.1, codigo_python=codigo)
    a2 = Agente(nombre="A2", duracion=0.1, dependencias_nombres=["A1"], codigo_python=codigo)
    a3 = Agente(nombre="A3", duracion=0.1, dependencias_nombres=["A2"], codigo_python=codigo)
    
    scheduler.agregar_agentes([a1, a2, a3])
    scheduler.resolver_dependencias()
    
    return scheduler


# ============================================================
# PRUEBAS DE FLUJO COMPLETO
# ============================================================

class TestFlujoCompleto:
    """Pruebas del flujo completo: creación → ejecución → guardado."""
    
    def test_flujo_completo_con_http_mock(self, temp_db, qapp):
        """
        Prueba el flujo completo con HTTP mockeado.
        CORREGIDO: Usa responses para mockear httpbin.org.
        """
        # 1. Crear agentes
        a1 = Agente(
            nombre="WebScraper",
            tipo=TipoAgente.HTTP,
            url_http="https://httpbin.org/get",
            metodo_http="GET",
            timeout_http=10
        )
        
        a2 = Agente(
            nombre="Procesador",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["WebScraper"],
            codigo_python="""
import json
import datetime

# Obtener datos del contexto
data = contexto.get('WebScraper', {})
json_data = data.get('json', {})

# Procesar datos
resultado = {
    'url': json_data.get('url', ''),
    'procesado': True,
    'timestamp': str(datetime.datetime.now()),
    'status': 'ok'
}
print(f"Procesado: {resultado['url']}")
"""
        )
        
        a3 = Agente(
            nombre="GeneradorReporte",
            tipo=TipoAgente.FILE,
            dependencias_nombres=["Procesador"],
            operacion_file="escribir",
            archivo_destino="reporte_integracion.txt"
        )
        
        # 2. Configurar scheduler
        scheduler = Scheduler(max_concurrent=2)
        scheduler.agregar_agentes([a1, a2, a3])
        scheduler.resolver_dependencias()
        
        # 3. Mockear HTTP con responses
        with patch('core.executors.http_executor.requests.Session') as mock_session_cls:
            # Configurar la sesión mock
            mock_session = MagicMock()
            mock_session_cls.return_value = mock_session

            # Configurar respuesta mock
            mock_response = MagicMock()
            mock_response.status_code = 200
            mock_response.json.return_value = {
                'url': 'https://httpbin.org/get',
                'headers': {'User-Agent': 'Agentes-Visuales/1.0'}
            }
            mock_response.text = json.dumps(mock_response.json.return_value)
            mock_response.headers = {'Content-Type': 'application/json'}
            mock_response.content = mock_response.text.encode('utf-8')
            mock_response.url = 'https://httpbin.org/get'
            mock_response.elapsed.total_seconds.return_value = 0.1

            # Configurar los métodos de la sesión
            mock_session.get.return_value = mock_response
            mock_session.post.return_value = mock_response
            mock_session.put.return_value = mock_response
            mock_session.delete.return_value = mock_response
            mock_session.patch.return_value = mock_response
            mock_session.head.return_value = mock_response
            mock_session.options.return_value = mock_response
            mock_session.close.return_value = None
            mock_session.mount.return_value = None
            
            # 4. Ejecutar
            terminado = False
            
            def on_terminado():
                nonlocal terminado
                terminado = True
            
            scheduler.ejecucion_terminada.connect(on_terminado)
            scheduler.iniciar()
            
            # Esperar a que termine
            completado = esperar(lambda: terminado, timeout=timeout, qapp=qapp)
            assert completado, f"El flujo no terminó en {timeout}s"
            # 5. Verificar resultados
            stats = scheduler.obtener_estadisticas()
            
            # Mostrar detalles de errores para depuración
            if stats['errores'] > 0:
                for agente in scheduler.agentes.values():
                    if agente.estado == EstadoAgente.ERROR:
                        print(f"❌ Error en {agente.nombre}: {agente.error}")
            
            assert stats['completados'] == 3, f"Completados: {stats['completados']}, Errores: {stats['errores']}"
            assert stats['total'] == 3
            assert stats['errores'] == 0
            
            # 6. Guardar en DB
            agentes_data = [a.to_dict() for a in scheduler.agentes.values()]
            duracion_total = 3.0
            ejecucion_id = temp_db.guardar_ejecucion(agentes_data, duracion_total)
            
            assert ejecucion_id is not None
            assert ejecucion_id > 0
            
            # 7. Verificar historial
            historial = temp_db.obtener_historial(limit=1)
            assert len(historial) > 0
            assert historial[0]['agentes_total'] == 3
            assert historial[0]['completados'] == 3
            
            # 8. Verificar detalle
            detalle = temp_db.obtener_detalle_ejecucion(ejecucion_id)
            assert len(detalle) == 3
            
            # 9. Limpiar
            if os.path.exists("reporte_integracion.txt"):
                os.unlink("reporte_integracion.txt")
    
    def test_flujo_completo_sin_http(self, temp_db, qapp):
        """
        Prueba el flujo completo sin dependencias HTTP.
        """
        # 1. Crear agentes (todos Python)
        a1 = Agente(
            nombre="Productor",
            tipo=TipoAgente.PYTHON,
            codigo_python="""
resultado = {
    'valor': 42,
    'mensaje': 'Hola desde productor'
}
print(f"Productor: {resultado['valor']}")
"""
        )
        
        a2 = Agente(
            nombre="Consumidor",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["Productor"],
            codigo_python="""
# Buscar datos del productor en el contexto
datos_productor = contexto.get('Productor', {})
valor_productor = datos_productor.get('valor', 0)

resultado = {
    'valor_recibido': valor_productor,
    'valor_doble': valor_productor * 2,
    'mensaje': 'Consumidor procesó el valor'
}
print(f"Consumidor: {resultado['valor_recibido']}")
"""
        )
        
        # 2. Configurar scheduler
        scheduler = Scheduler(max_concurrent=2)
        scheduler.agregar_agentes([a1, a2])
        scheduler.resolver_dependencias()
        
        # 3. Ejecutar
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 5
        start = time.time()
        
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        # 4. Verificar resultados
        stats = scheduler.obtener_estadisticas()
        
        if stats['errores'] > 0:
            for agente in scheduler.agentes.values():
                if agente.estado == EstadoAgente.ERROR:
                    print(f"❌ Error en {agente.nombre}: {agente.error}")
        
        assert stats['completados'] == 2
        assert stats['total'] == 2
        assert stats['errores'] == 0
        
        # 5. Verificar resultados de agentes
        a1_result = scheduler.obtener_agente_por_nombre("Productor")
        a2_result = scheduler.obtener_agente_por_nombre("Consumidor")
        
        assert a1_result.estado == EstadoAgente.COMPLETADO
        assert a2_result.estado == EstadoAgente.COMPLETADO
        
        assert a1_result.resultado.get('valor') == 42
        assert a2_result.resultado.get('valor_recibido') == 42
        assert a2_result.resultado.get('valor_doble') == 84
        
        # 6. Guardar en DB
        agentes_data = [a.to_dict() for a in scheduler.agentes.values()]
        ejecucion_id = temp_db.guardar_ejecucion(agentes_data, 2.0)
        
        assert ejecucion_id is not None
        assert ejecucion_id > 0
        
        # 7. Verificar historial
        historial = temp_db.obtener_historial(limit=1)
        assert len(historial) > 0
        assert historial[0]['agentes_total'] == 2
        assert historial[0]['completados'] == 2



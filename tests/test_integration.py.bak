# PRUEBAS DE EJECUCIÓN CON DEPENDENCIAS
# ============================================================

class TestEjecucionConDependencias:
    """Pruebas de ejecución con dependencias entre agentes."""
    
    def test_ejecutor_con_dependencias(self, qapp):
        """Prueba la ejecución con dependencias entre agentes."""
        scheduler = Scheduler(max_concurrent=1)
        
        # Agente productor
        a1 = Agente(
            nombre="Productor",
            tipo=TipoAgente.PYTHON,
            codigo_python="""
# Asignar resultado directamente
resultado = {
    'valor': 42,
    'mensaje': 'Hola desde productor'
}
print(f"Productor: {resultado['valor']}")
"""
        )
        
        # Agente consumidor - busca en el contexto de forma robusta
        a2 = Agente(
            nombre="Consumidor",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["Productor"],
            codigo_python="""
# Buscar datos del productor en el contexto
datos_productor = {}

# Intentar diferentes formas de obtener los datos
if 'Productor' in contexto:
    datos_productor = contexto.get('Productor', {})
else:
    # Buscar cualquier diccionario que tenga 'valor'
    for key, value in contexto.items():
        if isinstance(value, dict) and 'valor' in value:
            datos_productor = value
            break

# Obtener el valor (con fallback seguro)
valor_productor = datos_productor.get('valor', 0)

resultado = {
    'valor_recibido': valor_productor,
    'valor_doble': valor_productor * 2,
    'mensaje': 'Consumidor procesó el valor'
}
print(f"Consumidor: {resultado['valor_recibido']}")
"""
        )
        
        scheduler.agregar_agentes([a1, a2])
        scheduler.resolver_dependencias()
        
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 5
        start = time.time()
        
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        # Verificar resultados
        a1_result = scheduler.obtener_agente_por_nombre("Productor")
        a2_result = scheduler.obtener_agente_por_nombre("Consumidor")
        
        # Mostrar errores si los hay
        if a1_result.estado == EstadoAgente.ERROR:
            print(f"❌ Error en Productor: {a1_result.error}")
        if a2_result.estado == EstadoAgente.ERROR:
            print(f"❌ Error en Consumidor: {a2_result.error}")
        
        assert a1_result.estado == EstadoAgente.COMPLETADO
        assert a2_result.estado == EstadoAgente.COMPLETADO
        assert a2_result.resultado.get('valor_recibido') == 42
        assert a2_result.resultado.get('valor_doble') == 84
    
    def test_dependencias_multiples(self, qapp):
        """Prueba con múltiples dependencias."""
        scheduler = Scheduler(max_concurrent=2)
        
        # Dos productores independientes
        a1 = Agente(
            nombre="Productor1",
            tipo=TipoAgente.PYTHON,
            codigo_python="resultado = {'valor': 10}"
        )
        a2 = Agente(
            nombre="Productor2",
            tipo=TipoAgente.PYTHON,
            codigo_python="resultado = {'valor': 20}"
        )
        
        # Consumidor que depende de ambos
        a3 = Agente(
            nombre="Consumidor",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["Productor1", "Productor2"],
            codigo_python="""
v1 = contexto.get('Productor1', {}).get('valor', 0)
v2 = contexto.get('Productor2', {}).get('valor', 0)
resultado = {
    'suma': v1 + v2,
    'producto': v1 * v2,
    'status': 'ok'
}
"""
        )
        
        scheduler.agregar_agentes([a1, a2, a3])
        scheduler.resolver_dependencias()
        
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 5
        start = time.time()
        
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        stats = scheduler.obtener_estadisticas()
        assert stats['completados'] == 3
        
        consumidor = scheduler.obtener_agente_por_nombre("Consumidor")
        assert consumidor.estado == EstadoAgente.COMPLETADO
        assert consumidor.resultado.get('suma') == 30
        assert consumidor.resultado.get('producto') == 200
    
    def test_dependencia_inexistente(self):
        """Prueba con una dependencia que no existe."""
        scheduler = Scheduler(max_concurrent=2)
        
        a1 = Agente(
            nombre="A1",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["Inexistente"],
            codigo_python="resultado = {'ok': True}"
        )
        
        scheduler.agregar_agente(a1)
        scheduler.resolver_dependencias()
        
        # La dependencia inexistente debería ser ignorada
        assert len(a1.dependencias_ids) == 0


# ============================================================
# PRUEBAS DE RECUPERACIÓN DE ERRORES
# ============================================================

class TestRecuperacionErrores:
    """Pruebas de recuperación ante errores en la ejecución."""
    
    def test_recuperacion_errores(self, qapp):
        """Prueba la recuperación ante errores en la ejecución."""
        scheduler = Scheduler(max_concurrent=2)

        a1 = Agente(
            nombre="Falla",
            tipo=TipoAgente.PYTHON,
            codigo_python="x = 1 / 0",
            max_reintentos=0,   # sin reintentos: rápido y predecible
        )

        a2 = Agente(
            nombre="Dependiente",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["Falla"],
            codigo_python="resultado = {'mensaje': 'No debería ejecutarse'}",
        )

        scheduler.agregar_agentes([a1, a2])
        scheduler.resolver_dependencias()

        terminado = False
        def on_terminado():
            nonlocal terminado
            terminado = True

        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()

        timeout = 5
        start = time.time()
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)

        a1_result = scheduler.obtener_agente_por_nombre("Falla")
        a2_result = scheduler.obtener_agente_por_nombre("Dependiente")

        assert a1_result.estado == EstadoAgente.ERROR
        # El scheduler bloquea a los dependientes cuando la dependencia falla
        assert a2_result.estado == EstadoAgente.BLOQUEADO
        assert "Falla" in a2_result.mensaje or "bloqueado" in a2_result.mensaje.lower()


    def test_recuperacion_con_reintentos(self, qapp, tmp_path):
        """Prueba la recuperación con reintentos automáticos.

        Nota: cada intento corre en un sandbox aislado, así que usamos un
        archivo temporal como estado persistente entre reintentos.
        """
        scheduler = Scheduler(max_concurrent=2)
        estado_path = str(tmp_path / "intentos.txt")

        a1 = Agente(
            nombre="Reintento",
            tipo=TipoAgente.PYTHON,
            codigo_python=f"""
import os

estado_path = r"{estado_path}"

if os.path.exists(estado_path):
    with open(estado_path, "r") as f:
        contador = int(f.read().strip())
else:
    contador = 0

contador += 1

with open(estado_path, "w") as f:
    f.write(str(contador))

if contador < 3:
    raise ValueError(f"Fallo intencional #{{contador}}")

resultado = {{'exito': True, 'intentos': contador}}
""",
            max_reintentos=3,
        )

        scheduler.agregar_agente(a1)
        scheduler.resolver_dependencias()

        terminado = False
        def on_terminado():
            nonlocal terminado
            terminado = True

        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()

        timeout = 15
        start = time.time()
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)

        a1_result = scheduler.obtener_agente_por_nombre("Reintento")
        assert a1_result.estado == EstadoAgente.COMPLETADO
        assert a1_result.reintentos == 2  # 2 reintentos antes del éxito


    def test_reintentos_agotados(self, qapp):
        """Prueba cuando se agotan los reintentos."""
        scheduler = Scheduler(max_concurrent=2)
        
        a1 = Agente(
            nombre="FallaSiempre",
            tipo=TipoAgente.PYTHON,
            codigo_python="""
raise ValueError("Error persistente")
""",
            max_reintentos=2
        )
        
        scheduler.agregar_agente(a1)
        scheduler.resolver_dependencias()
        
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 10
        start = time.time()
        
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        a1_result = scheduler.obtener_agente_por_nombre("FallaSiempre")
        
        assert a1_result.estado == EstadoAgente.ERROR
        assert a1_result.reintentos == 2  # Dos reintentos agotados


# ============================================================
# PRUEBAS DE INTEGRACIÓN CON DATABASE
# ============================================================

class TestIntegracionDatabase:
    """Pruebas de integración con la base de datos."""
    
    def test_guardar_y_recuperar_ejecucion(self, temp_db):
        """Prueba guardar y recuperar una ejecución de la base de datos."""
        # Crear datos de prueba
        agentes = [
            {
                'id': 'a1',
                'nombre': 'Agente1',
                'tipo': 'Python',
                'estado': 'Completado',
                'duracion': 1.5,
                'dependencias': []
            },
            {
                'id': 'a2',
                'nombre': 'Agente2',
                'tipo': 'HTTP',
                'estado': 'Completado',
                'duracion': 2.0,
                'dependencias': ['a1']
            },
            {
                'id': 'a3',
                'nombre': 'Agente3',
                'tipo': 'LLM',
                'estado': 'Error',
                'duracion': 0.5,
                'dependencias': ['a2']
            }
        ]
        
        # Guardar
        ejecucion_id = temp_db.guardar_ejecucion(agentes, 4.0)
        assert ejecucion_id is not None
        assert ejecucion_id > 0
        
        # Recuperar historial
        historial = temp_db.obtener_historial(limit=10)
        assert len(historial) >= 1
        
        ejecucion = historial[0]
        assert ejecucion['agentes_total'] == 3
        assert ejecucion['completados'] == 2
        assert ejecucion['errores'] == 1
        assert ejecucion['duracion_total'] == 4.0
        
        # Recuperar detalle
        detalle = temp_db.obtener_detalle_ejecucion(ejecucion_id)
        assert len(detalle) == 3
        
        # Verificar agentes
        nombres = [d['nombre'] for d in detalle]
        assert 'Agente1' in nombres
        assert 'Agente2' in nombres
        assert 'Agente3' in nombres
        
        # Verificar dependencias
        for d in detalle:
            if d['nombre'] == 'Agente2':
                assert 'a1' in d['dependencias']
            elif d['nombre'] == 'Agente3':
                assert 'a2' in d['dependencias']
    
    def test_guardar_ejecucion_con_datos_complejos(self, temp_db):
        """Prueba guardar ejecución con resultados complejos."""
        agentes = [
            {
                'id': 'a1',
                'nombre': 'Procesador',
                'tipo': 'Python',
                'estado': 'Completado',
                'duracion': 1.0,
                'dependencias': [],
                'resultado': {
                    'data': [1, 2, 3, 4, 5],
                    'summary': {
                        'total': 5,
                        'promedio': 3.0,
                        'max': 5
                    }
                }
            }
        ]
        
        ejecucion_id = temp_db.guardar_ejecucion(agentes, 1.0)
        assert ejecucion_id is not None
        
        detalle = temp_db.obtener_detalle_ejecucion(ejecucion_id)
        assert len(detalle) == 1
        
        # El resultado no se guarda directamente en agentes_ejecucion
        # pero podemos verificar que la ejecución existe
        historial = temp_db.obtener_historial(limit=1)
        assert historial[0]['agentes_total'] == 1
    
    def test_obtener_historial_limitado(self, temp_db):
        """Prueba obtener historial con límite."""
        # Guardar varias ejecuciones
        for i in range(10):
            agentes = [
                {
                    'id': f'a{i}',
                    'nombre': f'Agente{i}',
                    'tipo': 'Python',
                    'estado': 'Completado',
                    'duracion': 0.5,
                    'dependencias': []
                }
            ]
            temp_db.guardar_ejecucion(agentes, 0.5)
        
        # Obtener con límite
        historial = temp_db.obtener_historial(limit=5)
        assert len(historial) == 5
        
        # Obtener sin límite (máx 20 por defecto)
        historial = temp_db.obtener_historial(limit=20)
        assert len(historial) == 10


# ============================================================
# PRUEBAS DE INTEGRACIÓN CON CONFIG MANAGER
# ============================================================

class TestIntegracionConfigManager:
    """Pruebas de integración con el gestor de configuraciones."""
    
    def test_guardar_y_cargar_configuracion(self, config_manager):
        """Prueba guardar y cargar una configuración completa."""
        # Crear agentes
        agentes = {
            'a1': Agente(
                nombre="Test1",
                tipo=TipoAgente.PYTHON,
                codigo_python="resultado = {'ok': True}",
                duracion=2.0
            ),
            'a2': Agente(
                nombre="Test2",
                tipo=TipoAgente.HTTP,
                url_http="https://api.example.com",
                duracion=3.0
            ),
            'a3': Agente(
                nombre="Test3",
                tipo=TipoAgente.LOOP,
                fuente_items="Test2.items",
                codigo_por_item="resultado = item",
                dependencias_nombres=["Test2"],
                max_iteraciones=10
            )
        }
        
        # Guardar
        nombre = "ConfigIntegracion"
        descripcion = "Configuración de prueba de integración"
        ruta = config_manager.guardar(agentes, nombre, descripcion)
        
        assert os.path.exists(ruta)
        assert nombre in ruta
        
        # Verificar que se guardó correctamente
        detalles = config_manager.listar_detalles()
        assert len(detalles) >= 1
        
        config = detalles[0]
        assert config['nombre'] == nombre
        assert config['descripcion'] == descripcion
        assert config['total_agentes'] == 3
        
        # Cargar
        cargados = config_manager.cargar(ruta)
        assert len(cargados) == 3
        
        # Verificar datos
        nombres = [a['nombre'] for a in cargados]
        assert 'Test1' in nombres
        assert 'Test2' in nombres
        assert 'Test3' in nombres
        
        # Verificar tipo Loop
        loop = next(a for a in cargados if a['nombre'] == 'Test3')
        assert loop['tipo'] == 'Loop'
        assert loop['fuente_items'] == 'Test2.items'
        assert loop['max_iteraciones'] == 10
    
    def test_listar_configuraciones(self, config_manager):
        """Prueba listar configuraciones guardadas."""
        # Guardar varias configuraciones
        for i in range(3):
            agentes = {
                f'a{i}': Agente(
                    nombre=f"ListTest{i}",
                    codigo_python=f"resultado = {{'id': {i}}}"
                )
            }
            config_manager.guardar(agentes, f"ListTest{i}", f"Desc {i}")
        
        detalles = config_manager.listar_detalles()
        assert len(detalles) == 3
        
        nombres = [d['nombre'] for d in detalles]
        assert 'ListTest0' in nombres
        assert 'ListTest1' in nombres
        assert 'ListTest2' in nombres
    
    def test_eliminar_configuracion(self, config_manager):
        """Prueba eliminar una configuración."""
        # Guardar
        agentes = {'a1': Agente(nombre="EliminarTest")}
        ruta = config_manager.guardar(agentes, "EliminarTest", "")
        
        assert os.path.exists(ruta)
        
        # Eliminar
        nombre_archivo = os.path.basename(ruta)
        resultado = config_manager.eliminar(nombre_archivo)
        
        assert resultado is True
        assert not os.path.exists(ruta)


# ============================================================
# PRUEBAS DE LOOP EN INTEGRACIÓN
# ============================================================

class TestLoopIntegracion:
    """Pruebas de integración con agentes LOOP."""
    
    def test_loop_completo_con_scheduler(self, qapp):
        """Prueba un loop completo en el scheduler."""
        scheduler = Scheduler(max_concurrent=2)
        
        # Productor de items
        productor = Agente(
            nombre="Productor",
            tipo=TipoAgente.PYTHON,
            codigo_python="""
resultado = {
    'items': ['item1', 'item2', 'item3', 'item4', 'item5'],
    'metadata': {
        'total': 5,
        'tipo': 'strings'
    }
}
"""
        )
        
        # Loop que procesa los items
        loop = Agente(
            nombre="Loop",
            tipo=TipoAgente.LOOP,
            dependencias_nombres=["Productor"],
            fuente_items="Productor.items",
            codigo_por_item="""
resultado = {
    'indice': indice,
    'item': item,
    'longitud': len(item),
    'mayusculas': item.upper(),
    'procesado': True
}
""",
            max_iteraciones=10,
            timeout_loop=5,
            continuar_en_error=False
        )
        
        # Consumidor del resultado del loop
        consumidor = Agente(
            nombre="Consumidor",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["Loop"],
            codigo_python="""
datos_loop = contexto.get('Loop', {})
items_procesados = datos_loop.get('items', [])

resultado = {
    'total_items': len(items_procesados),
    'primer_item': items_procesados[0] if items_procesados else None,
    'status': 'ok'
}
"""
        )
        
        scheduler.agregar_agentes([productor, loop, consumidor])
        scheduler.resolver_dependencias()
        
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 10
        start = time.time()
        
        if qapp:
            loop_qt = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop_qt.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop_qt.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        # Verificar resultados
        stats = scheduler.obtener_estadisticas()
        assert stats['completados'] == 3
        assert stats['total'] == 3
        assert stats['errores'] == 0
        
        # Verificar loop
        loop_agente = scheduler.obtener_agente_por_nombre("Loop")
        assert loop_agente.estado == EstadoAgente.COMPLETADO
        assert loop_agente.resultado.get('total_items') == 5
        assert loop_agente.resultado.get('exitos') == 5
        
        # Verificar consumidor
        consumidor_agente = scheduler.obtener_agente_por_nombre("Consumidor")
        assert consumidor_agente.estado == EstadoAgente.COMPLETADO
        assert consumidor_agente.resultado.get('total_items') == 5
    
    def test_loop_con_items_grandes(self, qapp):
        """Prueba loop procesando muchos items."""
        scheduler = Scheduler(max_concurrent=2)
        
        # Productor con muchos items
        productor = Agente(
            nombre="Productor",
            tipo=TipoAgente.PYTHON,
            codigo_python=f"""
resultado = {{
    'items': list(range({100}))
}}
"""
        )
        
        # Loop que procesa los items
        loop = Agente(
            nombre="Loop",
            tipo=TipoAgente.LOOP,
            dependencias_nombres=["Productor"],
            fuente_items="Productor.items",
            codigo_por_item="""
resultado = {
    'indice': indice,
    'cuadrado': item * item,
    'cubo': item * item * item
}
""",
            max_iteraciones=100,
            timeout_loop=30,
            continuar_en_error=False
        )
        
        scheduler.agregar_agentes([productor, loop])
        scheduler.resolver_dependencias()
        
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 30
        start = time.time()
        
        if qapp:
            loop_qt = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop_qt.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop_qt.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        stats = scheduler.obtener_estadisticas()
        assert stats['completados'] == 2
        assert stats['total'] == 2
        assert stats['errores'] == 0
        
        loop_agente = scheduler.obtener_agente_por_nombre("Loop")
        assert loop_agente.estado == EstadoAgente.COMPLETADO
        assert loop_agente.resultado.get('total_items') == 100
        assert loop_agente.resultado.get('exitos') == 100


# ============================================================
# PRUEBAS DE LIMPIEZA
# ============================================================

class TestLimpieza:
    """Pruebas de limpieza de recursos."""
    
    def test_limpieza_despues_de_ejecucion(self, qapp):
        """Prueba que los recursos se limpian correctamente después de ejecución."""
        scheduler = Scheduler(max_concurrent=2)
        
        a1 = Agente(
            nombre="A1",
            tipo=TipoAgente.PYTHON,
            codigo_python="resultado = {'ok': True}"
        )
        a2 = Agente(
            nombre="A2",
            tipo=TipoAgente.PYTHON,
            dependencias_nombres=["A1"],
            codigo_python="resultado = {'ok': True}"
        )
        
        scheduler.agregar_agentes([a1, a2])
        scheduler.resolver_dependencias()
        
        terminado = False
        
        def on_terminado():
            nonlocal terminado
            terminado = True
        
        scheduler.ejecucion_terminada.connect(on_terminado)
        scheduler.iniciar()
        
        # Esperar a que termine
        timeout = 5
        start = time.time()
        
        if qapp:
            loop = QEventLoop()
            timer = QTimer()
            timer.setSingleShot(True)
            timer.timeout.connect(loop.quit)
            
            while time.time() - start < timeout and not terminado:
                timer.start(50)
                loop.exec()
        else:
            while not terminado and (time.time() - start) < timeout:
                time.sleep(0.1)
        
        # Verificar que el executor se limpió correctamente
        assert scheduler._executor is not None
        assert not scheduler._executor._shutdown
        
        # Limpiar manualmente
        scheduler.limpiar()
        
        # Verificar estado de agentes
        for agente in scheduler.agentes.values():
            assert agente.estado == EstadoAgente.PENDIENTE
            assert agente.progreso == 0
    
    def test_cerrar_scheduler(self):
        """Prueba cerrar el scheduler correctamente."""
        scheduler = Scheduler(max_concurrent=2)
        
        a1 = Agente(
            nombre="A1",
            tipo=TipoAgente.PYTHON,
            codigo_python="resultado = {'ok': True}"
        )
        scheduler.agregar_agente(a1)
        
        # Cerrar
        scheduler.__del__()
        
        # Verificar que el executor se cerró
        assert scheduler._executor is not None
        # El executor debería estar en shutdown
        assert scheduler._executor._shutdown or scheduler._executor._shutdown is False


